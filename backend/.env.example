# --- Local development (copy to backend/.env) ---
# Secrets: use this file only — no Secret Manager / Cloud SQL Connector.

ENV=development

# Keep false for mock Pub/Sub + no GCP credential loading.
USE_GCP=false

# PostgreSQL — 本專案 root docker-compose 將容器 5432 對映到主機 15432。
# 若用 Docker Postgres：用下面這行（不要用 5432，否則會 connection refused）。
DATABASE_URL=postgresql+psycopg://user:password@localhost:15432/employee_safety
#
# 若本機已安裝 PostgreSQL 並直接聽 5432，可改用：
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/employee_safety

# Redis (Docker Compose maps 6379)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# JWT (placeholder until real auth)
JWT_SECRET=dev-only-change-me-in-production-use-strong-secret
# Access token lifetime in hours (default in Settings is 720 ≈ 30 days if unset)
# JWT_ACCESS_TOKEN_EXPIRE_HOURS=720

# --- GCP / Cloud Run 生產環境 ---
# USE_GCP=true
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json  # 本機用 SA JSON；Cloud Run 留空使用 ADC
#
# Pub/Sub 非同步通知派送（USE_GCP=true 時啟用）：
#   1. 在 GCP Console 建立 topic：gcloud pubsub topics create safety-notifications
#   2. 建立 push subscription 指向 Cloud Run：
#      gcloud pubsub subscriptions create safety-notifications-sub \
#        --topic=safety-notifications \
#        --push-endpoint=https://<CLOUD_RUN_URL>/api/internal/notifications/dispatch \
#        --push-auth-service-account=<SA_EMAIL>
#   3. 授予 SA pubsub.publisher 角色：
#      gcloud projects add-iam-policy-binding <PROJECT_ID> \
#        --member="serviceAccount:<SA_EMAIL>" --role="roles/pubsub.publisher"
# GCP_PROJECT_ID=           # e.g. my-gcp-project
# PUBSUB_NOTIFICATION_TOPIC=safety-notifications
# PUBSUB_REPORT_TOPIC=safety-reports
# USE_PUBSUB_EMULATOR=true  # 本機測試 Pub/Sub 時開啟
# PUBSUB_EMULATOR_HOST=localhost:8085

# --- Production DATABASE_URL examples (switch when deploying) ---
# Cloud SQL Unix socket (Cloud Run):
# DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@/DB_NAME?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
